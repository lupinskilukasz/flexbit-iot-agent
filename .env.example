# Copy this file to `.env` and adjust the values for your environment.
# The `.env` file is read automatically by `docker compose`.

# -----------------------------------------------------------------------------
# Agent image
# -----------------------------------------------------------------------------
# The container image to pull for the IoT Agent. Pin to a specific tag in
# production deployments rather than relying on `latest`.
#
# Examples:
#   IOT_AGENT_IMAGE=ghcr.io/lupinskilukasz/flexbit-iot-agent:0.1.0
#   IOT_AGENT_IMAGE=ghcr.io/lupinskilukasz/flexbit-iot-agent:latest
IOT_AGENT_IMAGE=ghcr.io/lupinskilukasz/flexbit-iot-agent:latest

# -----------------------------------------------------------------------------
# InfluxDB
# -----------------------------------------------------------------------------
# Auth token forwarded to the agent. The bundled InfluxDB 3 Core instance is
# started with `--without-auth`, so any non-empty placeholder works locally.
# Replace with a real token when you point the agent at a secured Influx.
INFLUX_TOKEN=local-dev-token

# -----------------------------------------------------------------------------
# Admin UI
# -----------------------------------------------------------------------------
# Base URL Grafana is reachable at from the operator's browser. Used by the
# agent to build the iframe on /admin/grafana. Change if you serve Grafana
# behind a reverse proxy on a different hostname.
GRAFANA_BASE_URL=http://localhost:3000
